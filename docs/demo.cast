[1.826, "o", "\u001b[H\u001b[2JSelect a session\r\nEnter opens the session root    \u2191/\u2193 move    Esc or Ctrl+C cancels\r\n\r\n\u001b[7m> auth-refactor   2 repositories\u001b[0m\r\n  payment-hotfix  1 repository\r\n"]
[3.624, "o", "\u001b[?25h\u001b[?1049l"]
[3.624, "o", "\u001b]0;mywt: auth-refactor\u0007[mywt: auth-refactor]  ~/.mywt/worktree-20261118180143-2\r\n\r\nSession root. Repository worktrees are the folders in this directory (this folder is not a git repository).\r\nclaude and codex can be started here, subject to each tool's own filesystem permissions and trust settings.\r\nType exit to return to your previous shell and directory.\r\n\r\n"]
